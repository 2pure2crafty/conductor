# Conductor deployment config.
#
# Copy this to the path the app reads (default: /etc/default/conductor, or set
# the CONDUCTOR_CONFIG env var to point elsewhere), then fill in real values.
# Keep it out of git and lock it down: chown to the service user, chmod 600.
#
#   sudo cp conductor.env.example /etc/default/conductor
#   sudo chown <service-user>:<service-user> /etc/default/conductor
#   sudo chmod 600 /etc/default/conductor

# HTTP basic-auth credentials for the Conductor UI. Generate a strong password,
# e.g.  openssl rand -hex 8
CONDUCTOR_USER=admin
CONDUCTOR_PASS=change-me

# Directory new projects are created under. Each new project becomes a
# subdirectory here.
CONDUCTOR_BASE_DIR=/var/www/agents

# Read-access glob written into each scaffolded agent's .claude/settings.json.
# Defaults to CONDUCTOR_BASE_DIR/** if unset. Widen or narrow as needed.
#CONDUCTOR_READ_SCOPE=/var/www/agents/**

# tmux session name that ttyd attaches to. Used by the dashboard's
# "Open terminal" deep-link to switch the terminal to a given agent.
CONDUCTOR_TTYD_SESSION=hds-remote

# Prefix for spawned agents' tmux session names:
#   <prefix>-<project-slug>-<agent-slug>
CONDUCTOR_TMUX_PREFIX=HDS

# Only needed if the app is reverse-proxied under a URL sub-path (e.g. nginx
# `location /conductor/`). Emits a <base> tag so relative links resolve under
# that prefix. Leave unset when served at the root of a host or port.
# NOTE: Tailscale `serve --set-path` registers an EXACT path (not a subtree),
# so it can't host a multi-page app this way; give Conductor its own HTTPS port
# instead, e.g.  sudo tailscale serve --bg --https=8443 http://127.0.0.1:7682
#CONDUCTOR_BASE_PATH=/conductor/

# --- Daemon (conductor-daemon.service) ------------------------------------
# The always-on watcher. It auto-wraps-down an agent only when BOTH: its context
# has grown past CONDUCTOR_WRAPDOWN_MIN_CONTEXT, AND it has then sat idle past
# CONDUCTOR_IDLE_TIMEOUT. It only ever touches agents with "auto_wrapdown": true
# in registry.json (opt-in). Wrapping a small context isn't worth the cost, so
# the size gate is the primary trigger; idle is the secondary timer.

# Where Claude Code writes per-project transcripts (used for token totals and
# live context size). Match the user the agents run as.
CONDUCTOR_TRANSCRIPTS_DIR=/home/patch/.claude/projects

# Idle seconds (while over the size gate) before wrap-down fires.
CONDUCTOR_IDLE_TIMEOUT=240

# Context-size gate in tokens. Below this, an idle agent is left alone. 0 = off.
CONDUCTOR_WRAPDOWN_MIN_CONTEXT=100000

# Seconds between daemon poll cycles.
CONDUCTOR_DAEMON_INTERVAL=30

# SAFETY: 1 = observe only (log decisions, take no real action: no kills, no
# token spend on digests). Set 0 to actually act. Leave at 1 until you've
# watched the log and trust its decisions.
CONDUCTOR_DAEMON_DRYRUN=1

# --- Tiered memory: digest roll-up (daemon job) ---------------------------
# The daemon regenerates memory/DIGEST.md from memory/HISTORY.md (the
# append-only session log) via a one-shot Haiku, once history has grown enough.
# Always regenerated from the whole HISTORY (never digest-of-digest), so
# fidelity doesn't compound. Non-destructive; still suppressed by dry-run.

# History must reach this est-token size before a digest is generated.
CONDUCTOR_DIGEST_THRESHOLD=15000
# And must grow this many est-tokens since the last digest before regenerating
# (amortizes the cost so it doesn't re-run every session).
CONDUCTOR_DIGEST_REGEN_DELTA=5000
# Model + timeout for the daemon's one-shot reasoning calls (digest, etc.).
CONDUCTOR_REASON_MODEL=haiku
CONDUCTOR_REASON_TIMEOUT=120

# --- Push notifications (daemon) ------------------------------------------
# When an agent starts waiting on a permission prompt, the daemon can push a
# phone alert (rising-edge: once per prompt). Uses an ntfy-compatible endpoint.
# Runs even in dry-run (it's observability). Leave CONDUCTOR_PUSH_URL empty to
# disable. PRIVACY: ntfy.sh is a public relay; the prompt question text is sent
# there. Prefer a self-hosted ntfy, or at least an unguessable topic + token.
#CONDUCTOR_PUSH_URL=https://ntfy.sh/your-unguessable-topic
#CONDUCTOR_PUSH_TOKEN=
# Tap-through target for the notification (your dashboard URL).
#CONDUCTOR_DASHBOARD_URL=https://<node>.<tailnet>.ts.net:8443/

# Audit log path (spin-ups, wrap-downs, deletes, nudges, version summaries).
# Must be writable by the web + daemon service user.
#CONDUCTOR_AUDIT_LOG=/var/log/conductor/audit.log
