# Conductor deployment config.
#
# Copy this to the path the app reads (default: /etc/default/conductor, or set
# the CONDUCTOR_CONFIG env var to point elsewhere), then fill in real values.
# Keep it out of git and lock it down: chown to the service user, chmod 600.
#
#   sudo cp conductor.env.example /etc/default/conductor
#   sudo chown <service-user>:<service-user> /etc/default/conductor
#   sudo chmod 600 /etc/default/conductor

# HTTP basic-auth credentials for the Conductor UI. Generate a strong password,
# e.g.  openssl rand -hex 8
CONDUCTOR_USER=admin
CONDUCTOR_PASS=change-me

# Directory new projects are created under. Each new project becomes a
# subdirectory here.
CONDUCTOR_BASE_DIR=/var/www/agents

# Read-access glob written into each scaffolded agent's .claude/settings.json.
# Defaults to CONDUCTOR_BASE_DIR/** if unset. Widen or narrow as needed.
#CONDUCTOR_READ_SCOPE=/var/www/agents/**

# tmux session name that ttyd attaches to. Used by the dashboard's
# "Open terminal" deep-link to switch the terminal to a given agent.
CONDUCTOR_TTYD_SESSION=hds-remote

# Prefix for spawned agents' tmux session names:
#   <prefix>-<project-slug>-<agent-slug>
CONDUCTOR_TMUX_PREFIX=HDS
