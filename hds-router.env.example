# HDS Router deployment config.
#
# Copy this to the path the app reads (default: /etc/default/hds-router, or set
# the ROUTER_CONFIG env var to point elsewhere), then fill in real values.
# Keep it out of git and lock it down: chown to the service user, chmod 600.
#
#   sudo cp hds-router.env.example /etc/default/hds-router
#   sudo chown <service-user>:<service-user> /etc/default/hds-router
#   sudo chmod 600 /etc/default/hds-router

# HTTP basic-auth credentials for the router UI. Generate a strong password,
# e.g.  openssl rand -hex 8
ROUTER_USER=admin
ROUTER_PASS=change-me

# Directory new projects are created under. Each new project becomes a
# subdirectory here.
ROUTER_BASE_DIR=/var/www/agents

# Read-access glob written into each scaffolded agent's .claude/settings.json.
# Defaults to ROUTER_BASE_DIR/** if unset. Widen or narrow as needed.
#ROUTER_READ_SCOPE=/var/www/agents/**

# tmux session name that ttyd attaches to. Used by the dashboard's
# "Open terminal" deep-link to switch the terminal to a given agent.
ROUTER_TTYD_SESSION=hds-remote

# Prefix for spawned agents' tmux session names:
#   <prefix>-<project-slug>-<agent-slug>
ROUTER_TMUX_PREFIX=HDS
